# URL del backend. En desarrollo apunta al puerto donde corre la API.
VITE_API_URL=http://localhost:5199

# Client ID de OAuth que da Google Cloud Console (Credenciales > ID de cliente
# de OAuth > Aplicacion web). No es secreto: viaja al navegador.
# Si se deja vacio, el login muestra el boton de "modo desarrollo", que solo
# funciona contra una Api corriendo en Development.
VITE_GOOGLE_CLIENT_ID=
